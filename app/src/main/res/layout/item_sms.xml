<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardview_sms"
    style="@style/ListItemCard"
    android:layout_width="match_parent"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/item_click_sms"
        style="@style/Match.Vertical"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:padding="16dp">

        <RelativeLayout style="@style/Match">

            <TextView
                android:id="@+id/address_item_sms"
                style="@style/Wrap.Medium"
                android:layout_centerVertical="true"
                android:textColor="@color/colorBlack" />

            <TextView
                android:id="@+id/date_item_sms"
                style="@style/Wrap.Small"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                tools:ignore="RelativeOverlap" />


        </RelativeLayout>

        <RelativeLayout style="@style/Match">

            <TextView
                android:id="@+id/message_item_sms"
                style="@style/Match.Width.Small"
                android:layout_marginEnd="20dp"
                android:layout_toStartOf="@+id/img_type_sms" />

            <ImageView
                android:id="@+id/img_type_sms"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/sampleimageviewsms" />

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>